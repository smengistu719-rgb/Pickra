    "AnalyticsEvent": {
      "title": "AnalyticsEvent",
      "description": "Immutable, non-PII interaction and conversion telemetry event monitored by the website owner.",
      "type": "object",
      "properties": {
        "actorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Authenticated user UID recording the event."
        },
        "actorScope": {
          "type": "string",
          "maxLength": 20,
          "enum": ["customer", "creator"],
          "description": "Non-PII actor role classification."
        },
        "targetOwnerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the creator who owns the target item or editorial_desk."
        },
        "eventType": {
          "type": "string",
          "maxLength": 30,
          "enum": ["post_view", "affiliate_click", "product_view", "bag_add", "promo_apply", "order_placed"],
          "description": "Type of monitored website interaction."
        },
        "channel": {
          "type": "string",
          "maxLength": 20,
          "enum": ["journal", "blog", "store", "affiliate", "services", "campaigns"],
          "description": "Website vertical where the interaction occurred."
        },
        "targetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Document or seed ID of the post, product, offer, campaign, or order."
        },
        "targetTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "Human-readable title of the target item."
        },
        "platform": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Marketplace or internal channel label."
        },
        "valueCents": {
          "type": "integer",
          "description": "Monetary value associated with the event in USD cents (0 for views/clicks)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": [
        "actorId",
        "actorScope",
        "targetOwnerId",
        "eventType",
        "channel",
        "targetId",
        "targetTitle",
        "platform",
        "valueCents",
        "createdAt"
      ]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Confidential Contact Us inquiry or Private/Data Issue report submitted by a guest visitor or signed-in member and restricted strictly to the sender and website owner.",
      "type": "object",
      "properties": {
        "senderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Verified sender Firebase Auth UID or guest_* session identifier."
        },
        "senderName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Sender full name."
        },
        "senderEmail": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254,
          "description": "Sender reply-to email address."
        },
        "category": {
          "type": "string",
          "maxLength": 32,
          "enum": ["general", "order_support", "seller_payout", "affiliate_partnership", "privacy_issue"],
          "description": "Inquiry or private issue classification."
        },
        "orderNumber": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40,
          "description": "Optional related Pickra order number (e.g., PKR-...)."
        },
        "subject": {
          "type": "string",
          "minLength": 3,
          "maxLength": 140,
          "description": "Concise inquiry or private issue subject line."
        },
        "message": {
          "type": "string",
          "minLength": 10,
          "maxLength": 3000,
          "description": "Detailed confidential message or private data/account request."
        },
        "status": {
          "type": "string",
          "maxLength": 20,
          "enum": ["unread", "in_review", "resolved"],
          "description": "Inquiry resolution lifecycle status with terminal resolved state."
        },
        "adminNote": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500,
          "description": "Internal website owner resolution note."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "senderId",
        "senderName",
        "senderEmail",
        "category",
        "orderNumber",
        "subject",
        "message",
        "status",
        "adminNote",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Trusted website owner and co-admin role lookup collection."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Public author, creator seller, and customer profile records without PII."
    },
    "/users/{userId}/private/{infoId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Owner-only PII, default affiliate network tags, and seller payout details."
    },
    "/offers/{offerId}": {
      "schema": { "$ref": "#/entities/AffiliateOffer" },
      "description": "Curated affiliate physical products, digital products, and professional services managed by the website owner."
    },
    "/posts/{postId}": {
      "schema": { "$ref": "#/entities/BlogPost" },
      "description": "Independent Medium-style editorial blog posts managed by the website owner."
    },
    "/directProducts/{productId}": {
      "schema": { "$ref": "#/entities/DirectProduct" },
      "description": "Multi-creator physical and digital products sold directly on Pickra Store with admin approval moderation."
    },
    "/productSecrets/{productId}": {
      "schema": { "$ref": "#/entities/ProductSecret" },
      "description": "Vaulted digital deliverables isolated from public storefront queries and unlocked only upon verified purchase."
    },
    "/campaigns/{campaignId}": {
      "schema": { "$ref": "#/entities/MarketingCampaign" },
      "description": "Storefront promotional campaigns and checkout discount codes."
    },
    "/directOrders/{orderId}": {
      "schema": { "$ref": "#/entities/DirectOrder" },
      "description": "Private customer purchase orders, masked payment confirmations, and creator seller payout records restricted to buyer, seller, and website owner."
    },
    "/siteConfig/{configId}": {
      "schema": { "$ref": "#/entities/SiteConfig" },
      "description": "Global site configuration singleton (/siteConfig/main) managed exclusively by the website owner."
    },
    "/analyticsEvents/{eventId}": {
      "schema": { "$ref": "#/entities/AnalyticsEvent" },
      "description": "Immutable non-PII website monitoring and conversion telemetry readable by the website owner."
    },
    "/contactMessages/{messageId}": {
      "schema": { "$ref": "#/entities/ContactMessage" },
      "description": "Confidential Contact Us inquiries and Private/Data Issue reports restricted strictly to the sender and website owner."
    }
  }
}
