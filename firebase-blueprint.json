{
  "entities": {
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted administrator membership record keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Administrator Firebase Auth UID."
        },
        "grantedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the administrator who granted access."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when admin access was recorded."
        }
      },
      "required": ["uid", "grantedBy", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public author, creator seller, or customer profile strictly isolated from PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Public editorial byline or display name."
        },
        "bio": {
          "type": "string",
          "minLength": 0,
          "maxLength": 300,
          "description": "Short public author or seller biography."
        },
        "isSeller": {
          "type": "boolean",
          "description": "Whether this user has registered and activated a Creator Store seller account."
        },
        "sellerStatus": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "enum": ["inactive", "pending", "active", "suspended"],
          "description": "Seller account lifecycle status enforced by backend rules."
        },
        "storeName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80,
          "description": "Public creator storefront studio name."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["uid", "displayName", "bio", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Owner-only private account PII, default affiliate tracking tags, and creator seller payout account.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
