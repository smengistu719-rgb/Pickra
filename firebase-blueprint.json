        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["uid", "email", "defaultAmazonTag", "defaultDigistoreId", "createdAt", "updatedAt"]
    },
    "AffiliateOffer": {
      "title": "AffiliateOffer",
      "description": "Curated physical product, digital product, or professional service with outbound affiliate link managed exclusively by the website owner.",
      "type": "object",
      "properties": {
        "authorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Website owner Firebase Auth UID."
        },
        "authorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Publisher public display name."
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140,
          "description": "Product or professional service title."
        },
        "kind": {
          "type": "string",
          "maxLength": 20,
          "enum": ["physical", "digital", "service"],
          "description": "Offering classification separating Product Affiliate (physical/digital) from Service Affiliate (service)."
        },
        "platform": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60,
          "description": "Partner marketplace or custom affiliate network."
        },
        "category": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60,
          "description": "Affiliate vertical or category."
        },
        "priceLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Formatted price or starting rate."
        },
        "commissionNote": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80,
          "description": "Optional commission structure note."
        },
        "affiliateUrl": {
          "type": "string",
          "format": "uri",
          "minLength": 8,
          "maxLength": 500,
          "pattern": "^https://.+",
          "description": "HTTPS outbound affiliate destination URL."
        },
        "imageKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180000,
          "description": "Preset asset key, HTTPS image URL, or compressed data:image upload."
        },
        "videoUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 250000,
          "description": "Optional HTTPS video URL or compact data:video upload."
        },
        "summary": {
          "type": "string",
          "minLength": 10,
          "maxLength": 2500,
          "description": "Detailed product or service affiliate description with embedded links."
        },
        "highlights": {
          "type": "array",
          "description": "Up to 4 concise product or service highlights."
        },
        "status": {
          "type": "string",
          "maxLength": 20,
          "enum": ["draft", "published", "archived"],
          "description": "Publication lifecycle status with terminal archived state."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "authorId",
        "authorName",
        "title",
        "kind",
        "platform",
        "category",
        "priceLabel",
        "commissionNote",
        "affiliateUrl",
        "imageKey",
        "summary",
        "highlights",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "BlogPost": {
      "title": "BlogPost",
