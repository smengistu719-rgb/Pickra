          "maxLength": 180,
          "description": "Creator payout rail and destination reference."
        },
        "payoutNote": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200,
          "description": "Disbursement transaction reference recorded by the website owner."
        },
        "fulfillmentNote": {
          "type": "string",
          "minLength": 0,
          "maxLength": 300,
          "description": "Tracking number or digital access instructions."
        },
        "status": {
          "type": "string",
          "maxLength": 20,
          "enum": ["paid", "processing", "shipped", "fulfilled", "cancelled"],
          "description": "Order fulfillment status with terminal fulfilled and cancelled states."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "buyerId",
        "sellerId",
        "orderNumber",
        "buyerName",
        "buyerEmail",
        "shippingAddress",
        "productIds",
        "itemsSummary",
        "itemCount",
        "fulfillmentType",
        "promoCode",
        "subtotalCents",
        "discountCents",
        "shippingCents",
        "totalCents",
        "fulfillmentNote",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "SiteConfig": {
      "title": "SiteConfig",
      "description": "Global site-wide publishing, module visibility controls, storefront shipping, announcement ribbon, and catalog configuration managed exclusively by the website owner.",
      "type": "object",
      "properties": {
        "siteTagline": {
          "type": "string",
          "minLength": 4,
          "maxLength": 140,
          "description": "Editorial masthead and footer positioning line."
        },
        "announcementEnabled": {
          "type": "boolean",
          "description": "Whether the top site-wide announcement ribbon is visible."
        },
        "announcementText": {
          "type": "string",
          "minLength": 0,
          "maxLength": 180,
          "description": "Announcement ribbon copy."
        },
        "announcementCtaLabel": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40,
          "description": "Optional announcement CTA button label."
        },
        "announcementTargetSection": {
          "type": "string",
          "maxLength": 20,
          "enum": ["store", "journal", "blog", "products", "services"],
          "description": "Destination section when announcement CTA is clicked."
        },
        "freeShippingThresholdCents": {
          "type": "integer",
          "description": "Order subtotal threshold in cents for free physical shipping (0 to 1000000)."
        },
        "flatShippingCents": {
          "type": "integer",
          "description": "Standard flat physical shipping fee in cents (0 to 100000)."
        },
        "defaultDisclosureText": {
          "type": "string",
          "minLength": 10,
          "maxLength": 400,
          "description": "Global FTC affiliate and direct store disclosure text."
        },
        "storeCheckoutEnabled": {
          "type": "boolean",
          "description": "Master switch controlling whether Direct Store checkout accepts new orders."
        },
        "blogEnabled": {
          "type": "boolean",
          "description": "Master switch controlling public visibility of the Blog module."
        },
        "storeEnabled": {
          "type": "boolean",
          "description": "Master switch controlling public visibility of the Store module."
        },
        "productAffiliateEnabled": {
          "type": "boolean",
          "description": "Master switch controlling public visibility of the Product Affiliate module."
        },
        "serviceAffiliateEnabled": {
          "type": "boolean",
          "description": "Master switch controlling public visibility of the Service Affiliate module."
        },
        "showStarterSeeds": {
          "type": "boolean",
          "description": "Whether starter showcase dispatches, direct products, and affiliate picks are shown alongside custom Firestore records."
        },
        "hiddenSeedIds": {
          "type": "array",
          "description": "Bounded list (max 50) of starter seed IDs deleted or replaced by the website owner."
        },
        "aboutMission": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2500,
          "description": "Custom About Us mission statement managed by the website owner."
        },
        "aboutStory": {
          "type": "string",
          "minLength": 0,
          "maxLength": 4000,
          "description": "Custom About Us editorial story and platform architecture overview."
        },
        "contactEmail": {
          "type": "string",
          "minLength": 0,
          "maxLength": 254,
          "description": "Official support and inquiries email displayed on Contact Us."
        },
        "contactPhone": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80,
          "description": "Optional support phone, Telegram, or WhatsApp contact channel."
        },
        "contactLocation": {
          "type": "string",
          "minLength": 0,
          "maxLength": 160,
          "description": "Publication desk location and operating hours."
        },
        "privacyPolicySummary": {
          "type": "string",
          "minLength": 0,
          "maxLength": 5000,
          "description": "Owner-customizable Privacy, Data Protection & Private Issues policy summary."
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
