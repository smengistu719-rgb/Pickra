rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Hardened Global Primitives
    // =========================================================================
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isVerifiedUser() && request.auth.uid == uid;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() &&
        request.auth.token.email is string &&
        request.auth.token.email.size() <= 254 &&
        request.auth.token.email == 'mengistushimelis@gmail.com';
    }

    function isAdmin() {
      return isVerifiedUser() && (
        isBootstrappedAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // =========================================================================
    // Validation Blueprints (Static Schema & Identity Checks — Zero DB Reads)
    // =========================================================================
    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'grantedBy', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'grantedBy', 'createdAt']) &&
        isValidId(data.uid) &&
        isValidId(data.grantedBy) &&
        data.grantedBy == request.auth.uid &&
        data.createdAt is timestamp;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'bio', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'bio', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.uid == request.auth.uid &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        data.bio is string && data.bio.size() <= 300 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data) {
      return data.keys().hasAll(['uid', 'email', 'defaultAmazonTag', 'defaultDigistoreId', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'defaultAmazonTag', 'defaultDigistoreId', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.uid == request.auth.uid &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        data.defaultAmazonTag is string && data.defaultAmazonTag.size() <= 60 &&
        data.defaultDigistoreId is string && data.defaultDigistoreId.size() <= 60 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidHighlightItem(val) {
      return val is string && val.size() >= 1 && val.size() <= 140;
    }

    function isValidHighlightsList(items) {
      return items is list &&
        items.size() <= 4 &&
        (items.size() < 1 || isValidHighlightItem(items[0])) &&
        (items.size() < 2 || isValidHighlightItem(items[1])) &&
        (items.size() < 3 || isValidHighlightItem(items[2])) &&
        (items.size() < 4 || isValidHighlightItem(items[3]));
    }

    function isValidOffer(data) {
      return data.keys().hasAll([
          'authorId', 'authorName', 'title', 'kind', 'platform', 'category',
          'priceLabel', 'commissionNote', 'affiliateUrl', 'imageKey',
          'summary', 'highlights', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'authorId', 'authorName', 'title', 'kind', 'platform', 'category',
          'priceLabel', 'commissionNote', 'affiliateUrl', 'imageKey',
          'summary', 'highlights', 'status', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.authorId) &&
        (data.authorId == request.auth.uid || isBootstrappedAdmin()) &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 140 &&
        data.kind is string && data.kind.size() <= 20 && data.kind in ['physical', 'digital', 'service'] &&
        data.platform is string && data.platform.size() <= 30 &&
        data.platform in ['Amazon', 'Digistore24', 'Upwork', 'Fiverr', 'Gumroad', 'ClickBank', 'Custom'] &&
        data.category is string && data.category.size() >= 2 && data.category.size() <= 60 &&
        data.priceLabel is string && data.priceLabel.size() >= 1 && data.priceLabel.size() <= 40 &&
        data.commissionNote is string && data.commissionNote.size() <= 80 &&
        data.affiliateUrl is string && data.affiliateUrl.size() >= 8 && data.affiliateUrl.size() <= 500 &&
        data.affiliateUrl.matches('^https://.+') &&
        data.imageKey is string && data.imageKey.size() >= 1 && data.imageKey.size() <= 500 &&
        data.summary is string && data.summary.size() >= 10 && data.summary.size() <= 400 &&
        isValidHighlightsList(data.highlights) &&
        data.status is string && data.status.size() <= 20 && data.status in ['draft', 'published', 'archived'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidOfferIdList(items) {
      return items is list &&
        items.size() <= 8 &&
        (items.size() < 1 || isValidId(items[0])) &&
        (items.size() < 2 || isValidId(items[1])) &&
        (items.size() < 3 || isValidId(items[2])) &&
        (items.size() < 4 || isValidId(items[3])) &&
        (items.size() < 5 || isValidId(items[4])) &&
        (items.size() < 6 || isValidId(items[5])) &&
        (items.size() < 7 || isValidId(items[6])) &&
        (items.size() < 8 || isValidId(items[7]));
    }

    function isValidPost(data) {
      return data.keys().hasAll([
          'authorId', 'authorName', 'title', 'subtitle', 'slug', 'category',
          'readTimeMinutes', 'coverImageKey', 'content', 'attachedOfferIds',
          'disclosureText', 'featured', 'status', 'publishedLabel',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'authorId', 'authorName', 'title', 'subtitle', 'slug', 'category',
          'readTimeMinutes', 'coverImageKey', 'content', 'attachedOfferIds',
          'disclosureText', 'featured', 'status', 'publishedLabel',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.authorId) &&
        (data.authorId == request.auth.uid || isBootstrappedAdmin()) &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
        data.title is string && data.title.size() >= 4 && data.title.size() <= 160 &&
        data.subtitle is string && data.subtitle.size() >= 8 && data.subtitle.size() <= 280 &&
        data.slug is string && data.slug.size() >= 2 && data.slug.size() <= 140 &&
        data.slug.matches('^[a-z0-9\\-]+$') &&
        data.category is string && data.category.size() <= 40 &&
        data.category in ['Hardware & Gear', 'Digital Systems', 'Freelance Talent', 'Field Guides'] &&
        data.readTimeMinutes is int && data.readTimeMinutes >= 1 && data.readTimeMinutes <= 60 &&
        data.coverImageKey is string && data.coverImageKey.size() >= 1 && data.coverImageKey.size() <= 500 &&
        data.content is string && data.content.size() >= 20 && data.content.size() <= 25000 &&
        isValidOfferIdList(data.attachedOfferIds) &&
        data.disclosureText is string && data.disclosureText.size() >= 10 && data.disclosureText.size() <= 400 &&
        data.featured is bool &&
        data.status is string && data.status.size() <= 20 && data.status in ['draft', 'published', 'archived'] &&
        data.publishedLabel is string && data.publishedLabel.size() >= 3 && data.publishedLabel.size() <= 40 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // =========================================================================
    // Collection Rules
    // =========================================================================

    // Trusted Admin Registry (No list permitted)
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list: if false;
      allow create: if isVerifiedUser() &&
        isValidId(adminId) &&
        isValidAdminRecord(incoming()) &&
        incoming().uid == adminId &&
        incoming().createdAt == request.time &&
        isAdmin();
      allow update: if false;
      allow delete: if isVerifiedUser() && isValidId(adminId) && isAdmin();
    }

    // Public Author Profiles (Strictly Non-PII; No list permitted)
    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'bio', 'updatedAt']);
      allow delete: if isVerifiedUser() && isValidId(userId) && (isOwner(userId) || isAdmin());

      // Split-Collection PII & Default Affiliate Tags (Master Gate Enforced)
      match /private/{infoId} {
        allow get: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(infoId) &&
          infoId == 'info' &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
        allow list: if false;
        allow create: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(infoId) &&
          infoId == 'info' &&
          isValidUserPrivateInfo(incoming()) &&
          incoming().uid == userId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
        allow update: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(infoId) &&
          infoId == 'info' &&
          isValidUserPrivateInfo(incoming()) &&
          incoming().uid == existing().uid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['email', 'defaultAmazonTag', 'defaultDigistoreId', 'updatedAt']) &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
        allow delete: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(infoId) &&
          infoId == 'info' &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          (
            (isOwner(userId) && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid) ||
            isAdmin()
          );
      }
    }

    // Curated Affiliate Products & Services
    match /offers/{offerId} {
      allow get: if isValidId(offerId) && (
        existing().status == 'published' ||
        (isSignedIn() && existing().authorId == request.auth.uid) ||
        isAdmin()
      );
      // Zero get()/exists() calls in list to prevent O(n) cost explosions
      allow list: if existing().status == 'published' ||
        (isSignedIn() && existing().authorId == request.auth.uid) ||
        isBootstrappedAdmin();
      allow create: if isVerifiedUser() &&
        isValidId(offerId) &&
        isValidOffer(incoming()) &&
        incoming().authorId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/users/$(incoming().authorId));
      allow update: if isVerifiedUser() &&
        isValidId(offerId) &&
        isValidOffer(incoming()) &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (existing().status != 'archived' || isAdmin()) &&
        (
          (
            existing().authorId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'authorName', 'title', 'kind', 'platform', 'category',
              'priceLabel', 'commissionNote', 'affiliateUrl', 'imageKey',
              'summary', 'highlights', 'status', 'updatedAt'
            ])
          ) ||
          (
            existing().authorId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          ) ||
          isAdmin()
        );
      allow delete: if isVerifiedUser() &&
        isValidId(offerId) &&
        (existing().authorId == request.auth.uid || isAdmin());
    }

    // Editorial Blog Posts with Attached Affiliate Links
    match /posts/{postId} {
      allow get: if isValidId(postId) && (
        existing().status == 'published' ||
        (isSignedIn() && existing().authorId == request.auth.uid) ||
        isAdmin()
      );
      // Zero get()/exists() calls in list to prevent O(n) cost explosions
      allow list: if existing().status == 'published' ||
        (isSignedIn() && existing().authorId == request.auth.uid) ||
        isBootstrappedAdmin();
      allow create: if isVerifiedUser() &&
        isValidId(postId) &&
        isValidPost(incoming()) &&
        incoming().authorId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/users/$(incoming().authorId));
      allow update: if isVerifiedUser() &&
        isValidId(postId) &&
        isValidPost(incoming()) &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (existing().status != 'archived' || isAdmin()) &&
        (
          (
            existing().authorId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'authorName', 'title', 'subtitle', 'slug', 'category',
              'readTimeMinutes', 'coverImageKey', 'content', 'attachedOfferIds',
              'disclosureText', 'featured', 'status', 'publishedLabel', 'updatedAt'
            ])
          ) ||
          (
            existing().authorId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'publishedLabel', 'updatedAt'])
          ) ||
          isAdmin()
        );
      allow delete: if isVerifiedUser() &&
        isValidId(postId) &&
        (existing().authorId == request.auth.uid || isAdmin());
    }
  }
}
