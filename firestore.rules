rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Hardened Global Primitives
    // =========================================================================
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isGuestBuyerId(id) {
      return id is string && id.size() >= 12 && id.size() <= 128 && id.matches('^guest_[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isOwner(uid) {
      return isVerifiedUser() && request.auth.uid == uid;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email is string &&
        request.auth.token.email.size() <= 254 &&
        request.auth.token.email == 'mengistushimelis@gmail.com';
    }

    function isAdmin() {
      return isVerifiedUser() && (
        isBootstrappedAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Relational Master Gate verifying Seller has registered store + active seller status + valid payout account
    function isActiveSellerUser(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)) &&
        get(/databases/$(database)/documents/users/$(uid)).data.isSeller == true &&
        (
          !('sellerStatus' in get(/databases/$(database)/documents/users/$(uid)).data) ||
          get(/databases/$(database)/documents/users/$(uid)).data.sellerStatus == 'active'
        ) &&
        exists(/databases/$(database)/documents/users/$(uid)/private/info) &&
        'payoutMethod' in get(/databases/$(database)/documents/users/$(uid)/private/info).data &&
        get(/databases/$(database)/documents/users/$(uid)/private/info).data.payoutMethod != 'None' &&
        'payoutAccount' in get(/databases/$(database)/documents/users/$(uid)/private/info).data &&
        get(/databases/$(database)/documents/users/$(uid)/private/info).data.payoutAccount.size() >= 3;
    }

    // =========================================================================
    // Validation Blueprints (Static Schema & Identity Checks — Zero DB Reads)
    // =========================================================================
    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'grantedBy', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'grantedBy', 'createdAt']) &&
        isValidId(data.uid) &&
        isValidId(data.grantedBy) &&
        isSignedIn() &&
        data.grantedBy == request.auth.uid &&
        data.createdAt is timestamp;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'bio', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'uid', 'displayName', 'bio', 'isSeller', 'sellerStatus', 'storeName', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        isSignedIn() &&
        (data.uid == request.auth.uid || isBootstrappedAdmin()) &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        data.bio is string && data.bio.size() <= 300 &&
        (!('isSeller' in data) || data.isSeller is bool) &&
        (!('sellerStatus' in data) || (
          data.sellerStatus is string &&
          data.sellerStatus.size() <= 20 &&
          data.sellerStatus in ['inactive', 'pending', 'active', 'suspended']
        )) &&
        (!('storeName' in data) || (data.storeName is string && data.storeName.size() <= 80)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPayoutAccountItem(val) {
      return val is string && val.size() >= 3 && val.size() <= 240;
    }

    function isValidPayoutAccountsList(items) {
      return items is list &&
        items.size() <= 6 &&
        (items.size() < 1 || isValidPayoutAccountItem(items[0])) &&
        (items.size() < 2 || isValidPayoutAccountItem(items[1])) &&
        (items.size() < 3 || isValidPayoutAccountItem(items[2])) &&
        (items.size() < 4 || isValidPayoutAccountItem(items[3])) &&
        (items.size() < 5 || isValidPayoutAccountItem(items[4])) &&
        (items.size() < 6 || isValidPayoutAccountItem(items[5]));
    }

    function isValidOptionalVideoUrl(val) {
      return val is string &&
        val.size() <= 250000 &&
        (val.size() == 0 || val.matches('^https://.+') || val.matches('^data:video/.+'));
    }

    function isValidOptionalDigitalFileUrl(val) {
      return val is string &&
        val.size() <= 560000 &&
        (val.size() == 0 || val.matches('^https://.+') || val.matches('^data:.+'));
    }

    function isValidUserPrivateInfo(data) {
      return data.keys().hasAll(['uid', 'email', 'defaultAmazonTag', 'defaultDigistoreId', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'uid', 'email', 'defaultAmazonTag', 'defaultDigistoreId',
          'payoutMethod', 'payoutAccount', 'payoutAccounts', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        isSignedIn() &&
        data.uid == request.auth.uid &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        data.defaultAmazonTag is string && data.defaultAmazonTag.size() <= 60 &&
        data.defaultDigistoreId is string && data.defaultDigistoreId.size() <= 60 &&
        (!('payoutMethod' in data) || (
          data.payoutMethod is string &&
          data.payoutMethod.size() <= 24 &&
          data.payoutMethod in [
            'None', 'Telebirr', 'CBEBirr', 'MobileMoney', 'BankTransfer',
            'Stripe', 'PayPal', 'Wise', 'Custom'
          ]
        )) &&
        (!('payoutAccount' in data) || (data.payoutAccount is string && data.payoutAccount.size() <= 160)) &&
        (!('payoutAccounts' in data) || isValidPayoutAccountsList(data.payoutAccounts)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidHighlightItem(val) {
      return val is string && val.size() >= 1 && val.size() <= 140;
    }

    function isValidHighlightsList(items) {
      return items is list &&
        items.size() <= 4 &&
        (items.size() < 1 || isValidHighlightItem(items[0])) &&
        (items.size() < 2 || isValidHighlightItem(items[1])) &&
        (items.size() < 3 || isValidHighlightItem(items[2])) &&
        (items.size() < 4 || isValidHighlightItem(items[3]));
    }

    function isValidOffer(data) {
      return data.keys().hasAll([
          'authorId', 'authorName', 'title', 'kind', 'platform', 'category',
          'priceLabel', 'commissionNote', 'affiliateUrl', 'imageKey',
          'summary', 'highlights', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'authorId', 'authorName', 'title', 'kind', 'platform', 'category',
          'priceLabel', 'commissionNote', 'affiliateUrl', 'imageKey', 'videoUrl',
          'summary', 'highlights', 'status', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.authorId) &&
        isSignedIn() &&
        (data.authorId == request.auth.uid || isBootstrappedAdmin()) &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 140 &&
        data.kind is string && data.kind.size() <= 20 && data.kind in ['physical', 'digital', 'service'] &&
        data.platform is string && data.platform.size() >= 2 && data.platform.size() <= 60 &&
        data.category is string && data.category.size() >= 2 && data.category.size() <= 60 &&
        data.priceLabel is string && data.priceLabel.size() >= 1 && data.priceLabel.size() <= 40 &&
        data.commissionNote is string && data.commissionNote.size() <= 80 &&
        data.affiliateUrl is string && data.affiliateUrl.size() >= 8 && data.affiliateUrl.size() <= 500 &&
        data.affiliateUrl.matches('^https://.+') &&
        data.imageKey is string && data.imageKey.size() >= 1 && data.imageKey.size() <= 180000 &&
        (!('videoUrl' in data) || isValidOptionalVideoUrl(data.videoUrl)) &&
        data.summary is string && data.summary.size() >= 10 && data.summary.size() <= 2500 &&
        isValidHighlightsList(data.highlights) &&
        data.status is string && data.status.size() <= 20 && data.status in ['draft', 'published', 'archived'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidOfferIdList(items) {
      return items is list &&
        items.size() <= 8 &&
        (items.size() < 1 || isValidId(items[0])) &&
        (items.size() < 2 || isValidId(items[1])) &&
        (items.size() < 3 || isValidId(items[2])) &&
        (items.size() < 4 || isValidId(items[3])) &&
        (items.size() < 5 || isValidId(items[4])) &&
        (items.size() < 6 || isValidId(items[5])) &&
        (items.size() < 7 || isValidId(items[6])) &&
        (items.size() < 8 || isValidId(items[7]));
    }

    function isValidPost(data) {
      return data.keys().hasAll([
          'authorId', 'authorName', 'title', 'subtitle', 'slug', 'category',
          'readTimeMinutes', 'coverImageKey', 'content', 'attachedOfferIds',
          'disclosureText', 'featured', 'status', 'publishedLabel',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'authorId', 'authorName', 'title', 'subtitle', 'slug', 'category',
          'readTimeMinutes', 'coverImageKey', 'content', 'theme', 'attachedOfferIds',
          'disclosureText', 'featured', 'status', 'publishedLabel',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.authorId) &&
        isSignedIn() &&
        (data.authorId == request.auth.uid || isBootstrappedAdmin()) &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
        data.title is string && data.title.size() >= 4 && data.title.size() <= 160 &&
        data.subtitle is string && data.subtitle.size() >= 8 && data.subtitle.size() <= 280 &&
        data.slug is string && data.slug.size() >= 2 && data.slug.size() <= 140 &&
        data.slug.matches('^[a-z0-9\\-]+$') &&
        data.category is string && data.category.size() >= 2 && data.category.size() <= 60 &&
        data.readTimeMinutes is int && data.readTimeMinutes >= 1 && data.readTimeMinutes <= 60 &&
        data.coverImageKey is string && data.coverImageKey.size() >= 1 && data.coverImageKey.size() <= 180000 &&
        data.content is string && data.content.size() >= 20 && data.content.size() <= 350000 &&
        (!('theme' in data) || (
          data.theme is string &&
          data.theme.size() <= 20 &&
          data.theme in ['classic', 'midnight', 'sage', 'terracotta', 'slate']
        )) &&
        isValidOfferIdList(data.attachedOfferIds) &&
        data.disclosureText is string && data.disclosureText.size() >= 10 && data.disclosureText.size() <= 400 &&
        data.featured is bool &&
        data.status is string && data.status.size() <= 20 && data.status in ['draft', 'published', 'archived'] &&
        data.publishedLabel is string && data.publishedLabel.size() >= 3 && data.publishedLabel.size() <= 40 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidDirectProduct(data) {
      return data.keys().hasAll([
          'sellerId', 'sellerName', 'title', 'subtitle', 'kind', 'category',
          'sku', 'priceCents', 'compareAtCents', 'stockCount', 'badgeLabel',
          'imageKey', 'summary', 'highlights', 'deliveryNote', 'featured',
          'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'sellerId', 'sellerName', 'title', 'subtitle', 'kind', 'category',
          'sku', 'priceCents', 'compareAtCents', 'stockCount', 'badgeLabel',
          'imageKey', 'videoUrl', 'digitalFileUrl', 'digitalFileName', 'digitalFileType',
          'hasDigitalAsset', 'approvalStatus', 'moderationNote', 'lastOrderRef',
          'summary', 'highlights', 'deliveryNote', 'featured',
          'status', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.sellerId) &&
        (
          (isSignedIn() && (data.sellerId == request.auth.uid || isBootstrappedAdmin())) ||
          ('lastOrderRef' in data && isValidId(data.lastOrderRef))
        ) &&
        data.sellerName is string && data.sellerName.size() >= 1 && data.sellerName.size() <= 80 &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 140 &&
        data.subtitle is string && data.subtitle.size() >= 4 && data.subtitle.size() <= 220 &&
        data.kind is string && data.kind.size() <= 20 && data.kind in ['physical', 'digital'] &&
        data.category is string && data.category.size() >= 2 && data.category.size() <= 60 &&
        data.sku is string && data.sku.size() >= 2 && data.sku.size() <= 40 &&
        data.sku.matches('^[A-Z0-9\\-]+$') &&
        data.priceCents is int && data.priceCents >= 100 && data.priceCents <= 10000000 &&
        data.compareAtCents is int && data.compareAtCents >= 0 && data.compareAtCents <= 10000000 &&
        data.stockCount is int && data.stockCount >= 0 && data.stockCount <= 100000 &&
        data.badgeLabel is string && data.badgeLabel.size() <= 40 &&
        data.imageKey is string && data.imageKey.size() >= 1 && data.imageKey.size() <= 180000 &&
        (!('videoUrl' in data) || isValidOptionalVideoUrl(data.videoUrl)) &&
        (!('digitalFileUrl' in data) || isValidOptionalDigitalFileUrl(data.digitalFileUrl)) &&
        (!('digitalFileName' in data) || (data.digitalFileName is string && data.digitalFileName.size() <= 140)) &&
        (!('digitalFileType' in data) || (data.digitalFileType is string && data.digitalFileType.size() <= 60)) &&
        (!('hasDigitalAsset' in data) || data.hasDigitalAsset is bool) &&
        (!('approvalStatus' in data) || (
          data.approvalStatus is string &&
          data.approvalStatus.size() <= 20 &&
          data.approvalStatus in ['pending', 'approved', 'rejected']
        )) &&
        (!('moderationNote' in data) || (data.moderationNote is string && data.moderationNote.size() <= 300)) &&
        (!('lastOrderRef' in data) || (
          data.lastOrderRef is string &&
          data.lastOrderRef.size() <= 128 &&
          (data.lastOrderRef.size() == 0 || isValidId(data.lastOrderRef))
        )) &&
        data.summary is string && data.summary.size() >= 10 && data.summary.size() <= 1500 &&
        isValidHighlightsList(data.highlights) &&
        data.deliveryNote is string && data.deliveryNote.size() >= 2 && data.deliveryNote.size() <= 200 &&
        data.featured is bool &&
        data.status is string && data.status.size() <= 20 && data.status in ['draft', 'published', 'archived'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidProductSecret(data) {
      return data.keys().hasAll([
          'productId', 'sellerId', 'digitalFileUrl', 'digitalFileName', 'digitalFileType', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'productId', 'sellerId', 'digitalFileUrl', 'digitalFileName', 'digitalFileType',
          'lastOrderRef', 'unlockedAt', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.productId) &&
        isValidId(data.sellerId) &&
        (
          (isSignedIn() && (data.sellerId == request.auth.uid || isBootstrappedAdmin())) ||
          ('lastOrderRef' in data && isValidId(data.lastOrderRef))
        ) &&
        isValidOptionalDigitalFileUrl(data.digitalFileUrl) &&
        data.digitalFileUrl.size() >= 1 &&
        data.digitalFileName is string && data.digitalFileName.size() <= 140 &&
        data.digitalFileType is string && data.digitalFileType.size() <= 60 &&
        (!('lastOrderRef' in data) || (
          data.lastOrderRef is string &&
          data.lastOrderRef.size() <= 128 &&
          (data.lastOrderRef.size() == 0 || isValidId(data.lastOrderRef))
        )) &&
        (!('unlockedAt' in data) || data.unlockedAt is timestamp) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCampaign(data) {
      return data.keys().hasAll([
          'authorId', 'title', 'description', 'promoCode', 'discountPercent',
          'minOrderCents', 'channel', 'featuredProductId', 'ctaLabel',
          'expiresLabel', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'authorId', 'title', 'description', 'promoCode', 'discountPercent',
          'minOrderCents', 'channel', 'featuredProductId', 'ctaLabel',
          'expiresLabel', 'status', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.authorId) &&
        isSignedIn() &&
        (data.authorId == request.auth.uid || isBootstrappedAdmin()) &&
        data.title is string && data.title.size() >= 3 && data.title.size() <= 120 &&
        data.description is string && data.description.size() >= 8 && data.description.size() <= 280 &&
        data.promoCode is string && data.promoCode.size() >= 3 && data.promoCode.size() <= 24 &&
        data.promoCode.matches('^[A-Z0-9_\\-]+$') &&
        data.discountPercent is int && data.discountPercent >= 5 && data.discountPercent <= 90 &&
        data.minOrderCents is int && data.minOrderCents >= 0 && data.minOrderCents <= 5000000 &&
        data.channel is string && data.channel.size() >= 2 && data.channel.size() <= 60 &&
        data.featuredProductId is string && data.featuredProductId.size() <= 128 &&
        (data.featuredProductId.size() == 0 || isValidId(data.featuredProductId)) &&
        data.ctaLabel is string && data.ctaLabel.size() >= 2 && data.ctaLabel.size() <= 40 &&
        data.expiresLabel is string && data.expiresLabel.size() >= 2 && data.expiresLabel.size() <= 40 &&
        data.status is string && data.status.size() <= 20 && data.status in ['draft', 'published', 'archived'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidOrderProductIdList(items) {
      return items is list &&
        items.size() >= 1 &&
        items.size() <= 8 &&
        isValidId(items[0]) &&
        (items.size() < 2 || isValidId(items[1])) &&
        (items.size() < 3 || isValidId(items[2])) &&
        (items.size() < 4 || isValidId(items[3])) &&
        (items.size() < 5 || isValidId(items[4])) &&
        (items.size() < 6 || isValidId(items[5])) &&
        (items.size() < 7 || isValidId(items[6])) &&
        (items.size() < 8 || isValidId(items[7]));
    }

    function isValidDirectOrder(data) {
      return data.keys().hasAll([
          'buyerId', 'sellerId', 'orderNumber', 'buyerName', 'buyerEmail',
          'shippingAddress', 'productIds', 'itemsSummary', 'itemCount',
          'fulfillmentType', 'promoCode', 'subtotalCents', 'discountCents',
          'shippingCents', 'totalCents', 'fulfillmentNote', 'status',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'buyerId', 'sellerId', 'sellerName', 'orderNumber', 'buyerName', 'buyerEmail',
          'shippingAddress', 'paymentMethod', 'paymentReference',
          'productIds', 'itemsSummary', 'itemCount',
          'fulfillmentType', 'promoCode', 'subtotalCents', 'discountCents',
          'shippingCents', 'totalCents', 'platformFeeCents', 'sellerPayoutCents',
          'payoutStatus', 'sellerPayoutDetails', 'payoutNote', 'fulfillmentNote', 'status',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.buyerId) &&
        isValidId(data.sellerId) &&
        (
          (isSignedIn() && (
            data.buyerId == request.auth.uid ||
            data.sellerId == request.auth.uid ||
            isBootstrappedAdmin()
          )) ||
          (!isSignedIn() && isGuestBuyerId(data.buyerId))
        ) &&
        (!('sellerName' in data) || (data.sellerName is string && data.sellerName.size() >= 1 && data.sellerName.size() <= 80)) &&
        data.orderNumber is string && data.orderNumber.size() >= 4 && data.orderNumber.size() <= 32 &&
        data.orderNumber.matches('^PKR-[A-Z0-9\\-]+$') &&
        data.buyerName is string && data.buyerName.size() >= 2 && data.buyerName.size() <= 80 &&
        data.buyerEmail is string && data.buyerEmail.size() >= 3 && data.buyerEmail.size() <= 254 &&
        data.shippingAddress is string && data.shippingAddress.size() <= 300 &&
        (!('paymentMethod' in data) || (
          data.paymentMethod is string &&
          data.paymentMethod.size() >= 2 &&
          data.paymentMethod.size() <= 24 &&
          data.paymentMethod in ['Card', 'Telebirr', 'CBEBirr', 'PayPal', 'BankTransfer']
        )) &&
        (!('paymentReference' in data) || (data.paymentReference is string && data.paymentReference.size() <= 80)) &&
        isValidOrderProductIdList(data.productIds) &&
        data.itemsSummary is string && data.itemsSummary.size() >= 2 && data.itemsSummary.size() <= 600 &&
        data.itemCount is int && data.itemCount >= 1 && data.itemCount <= 50 &&
        data.fulfillmentType is string && data.fulfillmentType.size() <= 20 &&
        data.fulfillmentType in ['physical', 'digital', 'mixed'] &&
        data.promoCode is string && data.promoCode.size() <= 24 &&
        data.subtotalCents is int && data.subtotalCents >= 100 && data.subtotalCents <= 50000000 &&
        data.discountCents is int && data.discountCents >= 0 && data.discountCents <= 50000000 &&
        data.shippingCents is int && data.shippingCents >= 0 && data.shippingCents <= 500000 &&
        data.totalCents is int && data.totalCents >= 0 && data.totalCents <= 50000000 &&
        (!('platformFeeCents' in data) || (data.platformFeeCents is int && data.platformFeeCents >= 0 && data.platformFeeCents <= 50000000)) &&
        (!('sellerPayoutCents' in data) || (data.sellerPayoutCents is int && data.sellerPayoutCents >= 0 && data.sellerPayoutCents <= 50000000)) &&
        (!('payoutStatus' in data) || (
          data.payoutStatus is string &&
          data.payoutStatus.size() <= 24 &&
          data.payoutStatus in ['pending', 'paid_out', 'not_applicable']
        )) &&
        (!('sellerPayoutDetails' in data) || (data.sellerPayoutDetails is string && data.sellerPayoutDetails.size() <= 180)) &&
        (!('payoutNote' in data) || (data.payoutNote is string && data.payoutNote.size() <= 200)) &&
        data.fulfillmentNote is string && data.fulfillmentNote.size() <= 300 &&
        data.status is string && data.status.size() <= 20 &&
        data.status in ['paid', 'processing', 'shipped', 'fulfilled', 'cancelled'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidHiddenSeedList(items) {
      return items is list &&
        items.size() <= 50 &&
        (items.size() == 0 || (items[0] is string && items[0].size() <= 128));
    }

    function isValidSiteConfig(data) {
      return data.keys().hasAll([
          'siteTagline', 'announcementEnabled', 'announcementText',
          'announcementCtaLabel', 'announcementTargetSection',
          'freeShippingThresholdCents', 'flatShippingCents',
          'defaultDisclosureText', 'storeCheckoutEnabled', 'showStarterSeeds',
          'updatedBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'siteTagline', 'announcementEnabled', 'announcementText',
          'announcementCtaLabel', 'announcementTargetSection',
          'freeShippingThresholdCents', 'flatShippingCents',
          'defaultDisclosureText', 'storeCheckoutEnabled',
          'blogEnabled', 'storeEnabled', 'productAffiliateEnabled', 'serviceAffiliateEnabled',
          'showStarterSeeds', 'hiddenSeedIds',
          'aboutMission', 'aboutStory', 'contactEmail', 'contactPhone', 'contactLocation', 'privacyPolicySummary',
          'updatedBy', 'createdAt', 'updatedAt'
        ]) &&
        data.siteTagline is string && data.siteTagline.size() >= 4 && data.siteTagline.size() <= 140 &&
        data.announcementEnabled is bool &&
        data.announcementText is string && data.announcementText.size() <= 180 &&
        data.announcementCtaLabel is string && data.announcementCtaLabel.size() <= 40 &&
        data.announcementTargetSection is string && data.announcementTargetSection.size() <= 20 &&
        data.announcementTargetSection in ['store', 'journal', 'blog', 'products', 'services'] &&
        data.freeShippingThresholdCents is int &&
        data.freeShippingThresholdCents >= 0 &&
        data.freeShippingThresholdCents <= 1000000 &&
        data.flatShippingCents is int &&
        data.flatShippingCents >= 0 &&
        data.flatShippingCents <= 100000 &&
        data.defaultDisclosureText is string &&
        data.defaultDisclosureText.size() >= 10 &&
        data.defaultDisclosureText.size() <= 400 &&
        data.storeCheckoutEnabled is bool &&
        (!('blogEnabled' in data) || data.blogEnabled is bool) &&
        (!('storeEnabled' in data) || data.storeEnabled is bool) &&
        (!('productAffiliateEnabled' in data) || data.productAffiliateEnabled is bool) &&
        (!('serviceAffiliateEnabled' in data) || data.serviceAffiliateEnabled is bool) &&
        data.showStarterSeeds is bool &&
        (!('hiddenSeedIds' in data) || isValidHiddenSeedList(data.hiddenSeedIds)) &&
        (!('aboutMission' in data) || (data.aboutMission is string && data.aboutMission.size() <= 2500)) &&
        (!('aboutStory' in data) || (data.aboutStory is string && data.aboutStory.size() <= 4000)) &&
        (!('contactEmail' in data) || (data.contactEmail is string && data.contactEmail.size() <= 254)) &&
        (!('contactPhone' in data) || (data.contactPhone is string && data.contactPhone.size() <= 80)) &&
        (!('contactLocation' in data) || (data.contactLocation is string && data.contactLocation.size() <= 160)) &&
        (!('privacyPolicySummary' in data) || (data.privacyPolicySummary is string && data.privacyPolicySummary.size() <= 5000)) &&
        isValidId(data.updatedBy) &&
        isSignedIn() &&
        data.updatedBy == request.auth.uid &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAnalyticsEvent(data) {
      return data.keys().hasAll([
          'actorId', 'actorScope', 'targetOwnerId', 'eventType', 'channel',
          'targetId', 'targetTitle', 'platform', 'valueCents', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'actorId', 'actorScope', 'targetOwnerId', 'eventType', 'channel',
          'targetId', 'targetTitle', 'platform', 'valueCents', 'createdAt'
        ]) &&
        isValidId(data.actorId) &&
        isSignedIn() &&
        data.actorId == request.auth.uid &&
        data.actorScope is string && data.actorScope.size() <= 20 &&
        data.actorScope in ['customer', 'creator'] &&
        isValidId(data.targetOwnerId) &&
        data.eventType is string && data.eventType.size() <= 30 &&
        data.eventType in ['post_view', 'affiliate_click', 'product_view', 'bag_add', 'promo_apply', 'order_placed'] &&
        data.channel is string && data.channel.size() <= 20 &&
        data.channel in ['journal', 'blog', 'store', 'affiliate', 'services', 'campaigns'] &&
        isValidId(data.targetId) &&
        data.targetTitle is string && data.targetTitle.size() >= 1 && data.targetTitle.size() <= 160 &&
        data.platform is string && data.platform.size() >= 1 && data.platform.size() <= 40 &&
        data.valueCents is int && data.valueCents >= 0 && data.valueCents <= 50000000 &&
        data.createdAt is timestamp;
    }

    function isValidContactMessage(data) {
      return data.keys().hasAll([
          'senderId', 'senderName', 'senderEmail', 'category',
          'orderNumber', 'subject', 'message', 'status', 'adminNote',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'senderId', 'senderName', 'senderEmail', 'category',
          'orderNumber', 'subject', 'message', 'status', 'adminNote',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.senderId) &&
        (
          (isSignedIn() && (
            data.senderId == request.auth.uid ||
            isBootstrappedAdmin() ||
            isAdmin()
          )) ||
          (!isSignedIn() && isGuestBuyerId(data.senderId))
        ) &&
        data.senderName is string && data.senderName.size() >= 2 && data.senderName.size() <= 80 &&
        data.senderEmail is string && data.senderEmail.size() >= 3 && data.senderEmail.size() <= 254 &&
        data.category is string && data.category.size() <= 32 &&
        data.category in ['general', 'order_support', 'seller_payout', 'affiliate_partnership', 'privacy_issue'] &&
        data.orderNumber is string && data.orderNumber.size() <= 40 &&
        data.subject is string && data.subject.size() >= 3 && data.subject.size() <= 140 &&
        data.message is string && data.message.size() >= 10 && data.message.size() <= 3000 &&
        data.status is string && data.status.size() <= 20 &&
        data.status in ['unread', 'in_review', 'resolved'] &&
        data.adminNote is string && data.adminNote.size() <= 500 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // =========================================================================
    // Collection Rules
    // =========================================================================

    // 1. Trusted Website Owner & Co-Admin Registry
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list: if isBootstrappedAdmin() ||
        (isVerifiedUser() && existing().grantedBy == request.auth.uid);
      allow create: if isVerifiedUser() &&
        isValidId(adminId) &&
        isValidAdminRecord(incoming()) &&
        incoming().uid == adminId &&
        incoming().createdAt == request.time &&
        isAdmin();
      allow update: if false;
      allow delete: if isVerifiedUser() && isValidId(adminId) && isAdmin();
    }

    // 2. Public Author, Seller & Customer Profiles (Strictly Non-PII; Admin-Only Directory Monitoring)
    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if isBootstrappedAdmin();
      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == userId &&
        incoming().uid == request.auth.uid &&
        (!('sellerStatus' in incoming()) || incoming().sellerStatus in ['inactive', 'pending', 'active']) &&
        (!('isSeller' in incoming()) || incoming().isSeller == false || ('storeName' in incoming() && incoming().storeName.size() >= 2)) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidUserProfile(incoming()) &&
        isVerifiedUser() &&
        isValidId(userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Action 1: Owner updates own profile or registers/activates seller storefront (cannot unsuspend if suspended)
          (
            isOwner(userId) &&
            (!('sellerStatus' in existing()) || existing().sellerStatus != 'suspended') &&
            (!('sellerStatus' in incoming()) || incoming().sellerStatus in ['inactive', 'pending', 'active']) &&
            (!('isSeller' in incoming()) || incoming().isSeller == false || ('storeName' in incoming() && incoming().storeName.size() >= 2)) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'bio', 'isSeller', 'sellerStatus', 'storeName', 'updatedAt'
            ])
          ) ||
          // Action 2: Website Owner / Admin moderates user & seller status (activate, suspend, edit)
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'bio', 'isSeller', 'sellerStatus', 'storeName', 'updatedAt'
            ])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(userId) && (isOwner(userId) || isAdmin());

      // 3. Split-Collection PII, Default Affiliate Tags & Seller Payout Account (Master Gate Enforced)
      match /private/{infoId} {
        allow get: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(infoId) &&
          infoId == 'info' &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
        allow list: if false;
        allow create: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(infoId) &&
          infoId == 'info' &&
          isValidUserPrivateInfo(incoming()) &&
          incoming().uid == userId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
        allow update: if isValidUserPrivateInfo(incoming()) &&
          isOwner(userId) &&
          isValidId(userId) &&
          isValidId(infoId) &&
          infoId == 'info' &&
          incoming().uid == existing().uid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'email', 'defaultAmazonTag', 'defaultDigistoreId',
            'payoutMethod', 'payoutAccount', 'payoutAccounts', 'updatedAt'
          ]) &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
        allow delete: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(infoId) &&
          infoId == 'info' &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          (
            (isOwner(userId) && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid) ||
            isAdmin()
          );
      }
    }

    // 4. Curated Affiliate Products & Professional Services (Website Owner-Managed)
    match /offers/{offerId} {
      allow get: if isValidId(offerId) && (
        existing().status == 'published' ||
        (isSignedIn() && existing().authorId == request.auth.uid) ||
        isAdmin()
      );
      allow list: if existing().status == 'published' ||
        (isSignedIn() && existing().authorId == request.auth.uid) ||
        isBootstrappedAdmin();
      allow create: if isVerifiedUser() &&
        isValidId(offerId) &&
        isValidOffer(incoming()) &&
        (incoming().authorId == request.auth.uid || isBootstrappedAdmin()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if isValidOffer(incoming()) &&
        isVerifiedUser() &&
        isValidId(offerId) &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAdmin() &&
        (
          (
            existing().authorId == request.auth.uid &&
            existing().status != 'archived' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'authorName', 'title', 'kind', 'platform', 'category',
              'priceLabel', 'commissionNote', 'affiliateUrl', 'imageKey', 'videoUrl',
              'summary', 'highlights', 'status', 'updatedAt'
            ])
          ) ||
          (
            existing().authorId == request.auth.uid &&
            existing().status != 'archived' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          ) ||
          isAdmin()
        );
      allow delete: if isVerifiedUser() &&
        isValidId(offerId) &&
        isAdmin();
    }

    // 5. Independent Medium-Style Editorial Blog Posts (Website Owner-Managed)
    match /posts/{postId} {
      allow get: if isValidId(postId) && (
        existing().status == 'published' ||
        (isSignedIn() && existing().authorId == request.auth.uid) ||
        isAdmin()
      );
      allow list: if existing().status == 'published' ||
        (isSignedIn() && existing().authorId == request.auth.uid) ||
        isBootstrappedAdmin();
      allow create: if isVerifiedUser() &&
        isValidId(postId) &&
        isValidPost(incoming()) &&
        (incoming().authorId == request.auth.uid || isBootstrappedAdmin()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if isValidPost(incoming()) &&
        isVerifiedUser() &&
        isValidId(postId) &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAdmin() &&
        (
          (
            existing().authorId == request.auth.uid &&
            existing().status != 'archived' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'authorName', 'title', 'subtitle', 'slug', 'category',
              'readTimeMinutes', 'coverImageKey', 'content', 'theme', 'attachedOfferIds',
              'disclosureText', 'featured', 'status', 'publishedLabel', 'updatedAt'
            ])
          ) ||
          (
            existing().authorId == request.auth.uid &&
            existing().status != 'archived' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'publishedLabel', 'updatedAt'])
          ) ||
          isAdmin()
        );
      allow delete: if isVerifiedUser() &&
        isValidId(postId) &&
        isAdmin();
    }

    // 6. Storefront Products (Active Sellers Manage Own Listings Subject to Admin Approval; Atomic Checkout Stock Decrements)
    match /directProducts/{productId} {
      allow get: if isValidId(productId) && (
        existing().status == 'published' ||
        (isSignedIn() && existing().sellerId == request.auth.uid) ||
        isAdmin()
      );
      allow list: if existing().status == 'published' ||
        (isSignedIn() && existing().sellerId == request.auth.uid) ||
        isBootstrappedAdmin();
      allow create: if isVerifiedUser() &&
        isValidId(productId) &&
        isValidDirectProduct(incoming()) &&
        (!('digitalFileUrl' in incoming()) || incoming().digitalFileUrl == '') &&
        (
          !('hasDigitalAsset' in incoming()) ||
          incoming().hasDigitalAsset == false ||
          existsAfter(/databases/$(database)/documents/productSecrets/$(productId))
        ) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          // Branch 1: Active Seller submits own product into pending moderation queue (cannot self-publish)
          (
            incoming().sellerId == request.auth.uid &&
            incoming().status == 'draft' &&
            'approvalStatus' in incoming() &&
            incoming().approvalStatus == 'pending' &&
            isActiveSellerUser(request.auth.uid)
          ) ||
          // Branch 2: Website Owner / Admin creates approved or draft store listing
          (
            isAdmin() &&
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
          )
        );
      allow update: if isValidDirectProduct(incoming()) &&
        isValidId(productId) &&
        incoming().sellerId == existing().sellerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          !('digitalFileUrl' in incoming().diff(existing()).affectedKeys()) ||
          incoming().digitalFileUrl == ''
        ) &&
        (
          !('hasDigitalAsset' in incoming()) ||
          incoming().hasDigitalAsset == false ||
          exists(/databases/$(database)/documents/productSecrets/$(productId)) ||
          existsAfter(/databases/$(database)/documents/productSecrets/$(productId))
        ) &&
        (
          // Action 1: Active Seller edits own product content (re-enters draft + pending admin review)
          (
            isVerifiedUser() &&
            existing().sellerId == request.auth.uid &&
            existing().status != 'archived' &&
            incoming().status == 'draft' &&
            'approvalStatus' in incoming() &&
            incoming().approvalStatus == 'pending' &&
            isActiveSellerUser(request.auth.uid) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'sellerName', 'title', 'subtitle', 'kind', 'category',
              'sku', 'priceCents', 'compareAtCents', 'stockCount', 'badgeLabel',
              'imageKey', 'videoUrl', 'digitalFileUrl', 'digitalFileName', 'digitalFileType',
              'hasDigitalAsset', 'approvalStatus', 'moderationNote',
              'summary', 'highlights', 'deliveryNote', 'featured',
              'status', 'updatedAt'
            ])
          ) ||
          // Action 2: Active Seller updates inventory stock or draft/publish visibility on an already Admin-approved product
          (
            isVerifiedUser() &&
            existing().sellerId == request.auth.uid &&
            existing().status != 'archived' &&
            'approvalStatus' in existing() &&
            existing().approvalStatus == 'approved' &&
            incoming().status in ['draft', 'published'] &&
            isActiveSellerUser(request.auth.uid) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'stockCount', 'updatedAt'])
          ) ||
          // Action 3: Atomic Checkout Physical Inventory Decrement (Guest or Signed-In Buyer)
          (
            existing().kind == 'physical' &&
            existing().status == 'published' &&
            'lastOrderRef' in incoming() &&
            isValidId(incoming().lastOrderRef) &&
            incoming().stockCount < existing().stockCount &&
            (existing().stockCount - incoming().stockCount) >= 1 &&
            (existing().stockCount - incoming().stockCount) <= 50 &&
            incoming().stockCount >= 0 &&
            incoming().diff(existing()).affectedKeys().hasOnly(['stockCount', 'lastOrderRef', 'updatedAt']) &&
            !exists(/databases/$(database)/documents/directOrders/$(incoming().lastOrderRef)) &&
            existsAfter(/databases/$(database)/documents/directOrders/$(incoming().lastOrderRef)) &&
            productId in getAfter(/databases/$(database)/documents/directOrders/$(incoming().lastOrderRef)).data.productIds
          ) ||
          // Action 4: Website Owner / Admin full moderation (approve, reject, edit, archive)
          (
            isVerifiedUser() &&
            isAdmin()
          )
        );
      allow delete: if isVerifiedUser() &&
        isValidId(productId) &&
        (
          (existing().sellerId == request.auth.uid && isActiveSellerUser(request.auth.uid)) ||
          isAdmin()
        );
    }

    // 7. Protected Digital Deliverable Vault (Isolated from Public Storefront; Unlocked Only After Verified Purchase)
    match /productSecrets/{productId} {
      allow get: if isValidId(productId) && (
        (isSignedIn() && existing().sellerId == request.auth.uid) ||
        isAdmin() ||
        (
          'unlockedAt' in existing() &&
          existing().unlockedAt is timestamp &&
          request.time < existing().unlockedAt + duration.value(5, 'm')
        )
      );
      allow list: if isBootstrappedAdmin();
      allow create: if isVerifiedUser() &&
        isValidId(productId) &&
        isValidProductSecret(incoming()) &&
        incoming().productId == productId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          (incoming().sellerId == request.auth.uid && isActiveSellerUser(request.auth.uid)) ||
          isAdmin()
        ) &&
        (
          exists(/databases/$(database)/documents/directProducts/$(productId)) ||
          existsAfter(/databases/$(database)/documents/directProducts/$(productId))
        );
      allow update: if isValidProductSecret(incoming()) &&
        isValidId(productId) &&
        incoming().productId == existing().productId &&
        incoming().sellerId == existing().sellerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Action 1: Active Seller updates own vaulted digital asset
          (
            isVerifiedUser() &&
            existing().sellerId == request.auth.uid &&
            isActiveSellerUser(request.auth.uid) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'digitalFileUrl', 'digitalFileName', 'digitalFileType', 'updatedAt'
            ])
          ) ||
          // Action 2: Atomic Checkout Digital Delivery Unlock (Guest or Signed-In Buyer creating paid order in same batch)
          (
            'lastOrderRef' in incoming() &&
            isValidId(incoming().lastOrderRef) &&
            'unlockedAt' in incoming() &&
            incoming().unlockedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly(['lastOrderRef', 'unlockedAt', 'updatedAt']) &&
            !exists(/databases/$(database)/documents/directOrders/$(incoming().lastOrderRef)) &&
            existsAfter(/databases/$(database)/documents/directOrders/$(incoming().lastOrderRef)) &&
            productId in getAfter(/databases/$(database)/documents/directOrders/$(incoming().lastOrderRef)).data.productIds
          ) ||
          // Action 3: Verified Signed-In Buyer Re-Download Unlock for Existing Paid Order
          (
            isVerifiedUser() &&
            'lastOrderRef' in incoming() &&
            isValidId(incoming().lastOrderRef) &&
            'unlockedAt' in incoming() &&
            incoming().unlockedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly(['lastOrderRef', 'unlockedAt', 'updatedAt']) &&
            exists(/databases/$(database)/documents/directOrders/$(incoming().lastOrderRef)) &&
            get(/databases/$(database)/documents/directOrders/$(incoming().lastOrderRef)).data.buyerId == request.auth.uid &&
            get(/databases/$(database)/documents/directOrders/$(incoming().lastOrderRef)).data.status != 'cancelled' &&
            productId in get(/databases/$(database)/documents/directOrders/$(incoming().lastOrderRef)).data.productIds
          ) ||
          // Action 4: Website Owner / Admin override
          (
            isVerifiedUser() &&
            isAdmin()
          )
        );
      allow delete: if isVerifiedUser() &&
        isValidId(productId) &&
        (
          (existing().sellerId == request.auth.uid && isActiveSellerUser(request.auth.uid)) ||
          isAdmin()
        );
    }

    // 8. Marketing Campaigns & Checkout Promo Codes (Website Owner-Managed)
    match /campaigns/{campaignId} {
      allow get: if isValidId(campaignId) && (
        existing().status == 'published' ||
        (isSignedIn() && existing().authorId == request.auth.uid) ||
        isAdmin()
      );
      allow list: if existing().status == 'published' ||
        (isSignedIn() && existing().authorId == request.auth.uid) ||
        isBootstrappedAdmin();
      allow create: if isVerifiedUser() &&
        isValidId(campaignId) &&
        isValidCampaign(incoming()) &&
        (incoming().authorId == request.auth.uid || isBootstrappedAdmin()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if isValidCampaign(incoming()) &&
        isVerifiedUser() &&
        isValidId(campaignId) &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAdmin() &&
        (
          (
            existing().authorId == request.auth.uid &&
            existing().status != 'archived' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'description', 'promoCode', 'discountPercent',
              'minOrderCents', 'channel', 'featuredProductId', 'ctaLabel',
              'expiresLabel', 'status', 'updatedAt'
            ])
          ) ||
          (
            existing().authorId == request.auth.uid &&
            existing().status != 'archived' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          ) ||
          isAdmin()
        );
      allow delete: if isVerifiedUser() &&
        isValidId(campaignId) &&
        isAdmin();
    }

    // 9. Direct Customer Orders, Payment Records & Creator Payout Ledger (Strictly Private PII: Buyer, Seller, and Website Owner)
    match /directOrders/{orderId} {
      allow get: if isVerifiedUser() && isValidId(orderId) && (
        existing().buyerId == request.auth.uid ||
        existing().sellerId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isVerifiedUser() && (
        existing().buyerId == request.auth.uid ||
        existing().sellerId == request.auth.uid ||
        isBootstrappedAdmin()
      );
      allow create: if isValidId(orderId) &&
        isValidDirectOrder(incoming()) &&
        incoming().status == 'paid' &&
        (!('payoutStatus' in incoming()) || incoming().payoutStatus in ['pending', 'not_applicable']) &&
        (!('payoutNote' in incoming()) || incoming().payoutNote == '') &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          (
            isVerifiedUser() &&
            incoming().buyerId == request.auth.uid &&
            exists(/databases/$(database)/documents/users/$(incoming().buyerId))
          ) ||
          (!isSignedIn() && isGuestBuyerId(incoming().buyerId))
        ) &&
        (
          !exists(/databases/$(database)/documents/siteConfig/main) ||
          get(/databases/$(database)/documents/siteConfig/main).data.storeCheckoutEnabled == true
        );
      allow update: if isValidDirectOrder(incoming()) &&
        isVerifiedUser() &&
        isValidId(orderId) &&
        incoming().buyerId == existing().buyerId &&
        incoming().sellerId == existing().sellerId &&
        incoming().orderNumber == existing().orderNumber &&
        incoming().totalCents == existing().totalCents &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Action 1: Active Seller advances fulfillment status and tracking/delivery note prior to terminal state
          (
            existing().sellerId == request.auth.uid &&
            !(existing().status in ['fulfilled', 'cancelled']) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'fulfillmentNote', 'sellerPayoutDetails', 'updatedAt'
            ])
          ) ||
          // Action 2: Seller updates payout account details while payout has not yet been disbursed
          (
            existing().sellerId == request.auth.uid &&
            (!('payoutStatus' in existing()) || existing().payoutStatus != 'paid_out') &&
            incoming().diff(existing()).affectedKeys().hasOnly(['sellerPayoutDetails', 'updatedAt'])
          ) ||
          // Action 3: Buyer cancels order prior to fulfillment processing
          (
            existing().buyerId == request.auth.uid &&
            existing().status == 'paid' &&
            incoming().status == 'cancelled' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          ) ||
          // Action 4: Website Owner / Admin override (fulfillment, order management & payout disbursement)
          isAdmin()
        );
      allow delete: if isVerifiedUser() &&
        isValidId(orderId) &&
        isAdmin();
    }

    // 10. Global Site Configuration Singleton (/siteConfig/main — Website Owner-Managed)
    match /siteConfig/{configId} {
      allow get: if isValidId(configId) && configId == 'main';
      allow list: if false;
      allow create: if isVerifiedUser() &&
        isValidId(configId) &&
        configId == 'main' &&
        isValidSiteConfig(incoming()) &&
        incoming().updatedBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin() &&
        exists(/databases/$(database)/documents/users/$(incoming().updatedBy));
      allow update: if isValidSiteConfig(incoming()) &&
        isVerifiedUser() &&
        isValidId(configId) &&
        configId == 'main' &&
        incoming().updatedBy == request.auth.uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'siteTagline', 'announcementEnabled', 'announcementText',
          'announcementCtaLabel', 'announcementTargetSection',
          'freeShippingThresholdCents', 'flatShippingCents',
          'defaultDisclosureText', 'storeCheckoutEnabled',
          'blogEnabled', 'storeEnabled', 'productAffiliateEnabled', 'serviceAffiliateEnabled',
          'showStarterSeeds', 'hiddenSeedIds',
          'aboutMission', 'aboutStory', 'contactEmail', 'contactPhone', 'contactLocation', 'privacyPolicySummary',
          'updatedBy', 'updatedAt'
        ]) &&
        isAdmin();
      allow delete: if isVerifiedUser() &&
        isValidId(configId) &&
        configId == 'main' &&
        isAdmin();
    }

    // 11. Website Monitoring & Conversion Telemetry (Append-Only; Website Owner-Monitored)
    match /analyticsEvents/{eventId} {
      allow get: if isVerifiedUser() && isValidId(eventId) && (
        existing().actorId == request.auth.uid ||
        existing().targetOwnerId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isVerifiedUser() && (
        existing().targetOwnerId == request.auth.uid ||
        isBootstrappedAdmin()
      );
      allow create: if isVerifiedUser() &&
        isValidId(eventId) &&
        isValidAnalyticsEvent(incoming()) &&
        incoming().actorId == request.auth.uid &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/users/$(incoming().actorId));
      allow update: if false;
      allow delete: if isVerifiedUser() &&
        isValidId(eventId) &&
        isAdmin();
    }

    // 12. Confidential Contact Us Inquiries & Private/Data Issue Reports (Restricted Strictly to Sender & Website Owner)
    match /contactMessages/{messageId} {
      allow get: if isVerifiedUser() && isValidId(messageId) && (
        existing().senderId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isVerifiedUser() && (
        existing().senderId == request.auth.uid ||
        isBootstrappedAdmin()
      );
      allow create: if isValidId(messageId) &&
        isValidContactMessage(incoming()) &&
        incoming().status == 'unread' &&
        incoming().adminNote == '' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          (
            isVerifiedUser() &&
            incoming().senderId == request.auth.uid &&
            exists(/databases/$(database)/documents/users/$(incoming().senderId))
          ) ||
          (!isSignedIn() && isGuestBuyerId(incoming().senderId))
        );
      allow update: if isValidContactMessage(incoming()) &&
        isVerifiedUser() &&
        isValidId(messageId) &&
        incoming().senderId == existing().senderId &&
        incoming().senderName == existing().senderName &&
        incoming().senderEmail == existing().senderEmail &&
        incoming().category == existing().category &&
        incoming().orderNumber == existing().orderNumber &&
        incoming().subject == existing().subject &&
        incoming().message == existing().message &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Action 1: Verified sender closes own open inquiry/private issue prior to terminal resolved state
          (
            existing().senderId == request.auth.uid &&
            existing().status != 'resolved' &&
            incoming().status == 'resolved' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          ) ||
          // Action 2: Website Owner / Admin updates inquiry status and internal resolution note
          isAdmin()
        );
      allow delete: if isVerifiedUser() &&
        isValidId(messageId) &&
        isAdmin();
    }
  }
}
